---
import { tinkerlyConfig, getWhatsAppUrl } from '../config/tinkerly.config';
const wa = getWhatsAppUrl();
---
<header class="tk-header" data-tk-header>
  <div class="tk-container tk-header__inner">
    <a class="tk-header__brand" href="/#inicio" aria-label="Tinkerly, ir al inicio">
      <img src="/brand/tinkerly-mark.png" alt="" width="38" height="43" decoding="async" />
      <img src="/brand/tinkerly-wordmark.png" alt="Tinkerly" width="132" height="42" decoding="async" />
    </a>
    <nav class="tk-header__nav" aria-label="Navegación principal">
      {tinkerlyConfig.navigation.map(item => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="tk-header__actions">
      <button class="tk-theme-toggle" type="button" data-tk-theme-toggle aria-label="Activar modo oscuro" aria-pressed="false" title="Activar modo oscuro">
        <svg class="tk-theme-toggle__moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.985 12.486A9 9 0 0 1 11.514 3.015a9 9 0 1 0 9.471 9.471Z" /></svg>
        <svg class="tk-theme-toggle__sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg>
      </button>
      <a class="tk-button tk-button--primary tk-header__cta" href={wa ?? '/#contacto'} {...(wa ? {target: '_blank', rel: 'noopener noreferrer'} : {})}>Consultar pedido <span aria-hidden="true">↗</span></a>
      <button class="tk-header__menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="tk-mobile-menu" data-tk-menu-button>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <nav id="tk-mobile-menu" class="tk-header__mobile" aria-label="Menú móvil" hidden data-tk-mobile-menu>
    <div class="tk-container tk-header__mobile-links">
      {tinkerlyConfig.navigation.map(item => <a href={item.href}>{item.label}</a>)}
      <a class="tk-button tk-button--primary" href={wa ?? '/#contacto'} {...(wa ? {target:'_blank', rel:'noopener noreferrer'} : {})}>Consultar pedido ↗</a>
    </div>
  </nav>
</header>
<script>
  // Follow system theme unless the visitor explicitly chooses one.
  const themeButton = document.querySelector<HTMLButtonElement>('[data-tk-theme-toggle]');
  const themeMedia = window.matchMedia('(prefers-color-scheme: dark)');
  const themeKey = 'tinkerly-theme';
  const readSavedTheme = (): 'dark' | 'light' | null => {
    try {
      const saved = localStorage.getItem(themeKey);
      return saved === 'dark' || saved === 'light' ? saved : null;
    } catch { return null; }
  };
  const applyTheme = (theme: 'dark' | 'light') => {
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    const label = theme === 'dark' ? 'Activar modo claro' : 'Activar modo oscuro';
    themeButton?.setAttribute('aria-label', label);
    themeButton?.setAttribute('title', label);
    themeButton?.setAttribute('aria-pressed', String(theme === 'dark'));
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#1E1720' : '#FFFFFF');
  };
  applyTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
  themeButton?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem(themeKey, next); } catch {}
    applyTheme(next);
  });
  themeMedia.addEventListener('change', (event) => {
    if (!readSavedTheme()) applyTheme(event.matches ? 'dark' : 'light');
  });
  window.addEventListener('storage', (event) => {
    if (event.key === themeKey || event.key === null) {
      applyTheme(readSavedTheme() ?? (themeMedia.matches ? 'dark' : 'light'));
    }
  });

  const toggle = document.querySelector<HTMLButtonElement>('[data-tk-menu-button]');
  const mobile = document.querySelector<HTMLElement>('[data-tk-mobile-menu]');
  const setMenu = (open: boolean) => {
    if (!toggle || !mobile) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    mobile.hidden = !open;
  };
  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  mobile?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') setMenu(false); });
  window.addEventListener('resize', () => { if (window.innerWidth > 880) setMenu(false); });
</script>
