---
interface Props {
  direction?: 'up-right' | 'right';
}
const { direction = 'up-right' } = Astro.props;
---
<svg class="tk-arrow-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {direction === 'right' ? (
    <>
      <path d="M5 12h14" />
      <path d="m12 5 7 7-7 7" />
    </>
  ) : (
    <>
      <path d="M7 17 17 7" />
      <path d="M7 7h10v10" />
    </>
  )}
</svg>
