---
import { tinkerlyConfig, getWhatsAppUrl } from '../config/tinkerly.config';
const wa = getWhatsAppUrl();
const year = new Date().getFullYear();
import ArrowIcon from './ArrowIcon.astro';
---
<footer class="tk-footer">
  <div class="tk-container tk-footer__grid">
    <div>
      <a href="/#inicio" class="tk-footer__brand" aria-label="Tinkerly, ir al inicio">
        <img src="/brand/tinkerly-mark.png" alt="" width="34" height="38" loading="lazy" />
        <img src="/brand/tinkerly-wordmark.png" alt="Tinkerly" width="133" height="42" loading="lazy" />
      </a>
      <p>Papelería creativa personalizada para regalos, celebraciones y detalles hechos a tu gusto.</p>
      <p class="tk-footer__location">Managua, Nicaragua</p>
    </div>
    <div>
      <h2>Explora</h2>
      <nav class="tk-footer__nav" aria-label="Enlaces del pie">
        {tinkerlyConfig.navigation.map(item => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>
    <div>
      <h2>Tu próximo detalle</h2>
      <p>Consulta nuestras opciones de personalización y conoce cómo hacer tu pedido.</p>
      {wa ? (
        <a class="tk-footer__link tk-footer__social" href={wa} target="_blank" rel="noopener noreferrer" aria-label="Escríbenos por WhatsApp">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M20.4 11.7a8.5 8.5 0 0 1-12.55 7.43L3.3 20.5l1.39-4.55A8.5 8.5 0 1 1 20.4 11.7Z" />
            <path d="M8.3 7.9c-.5.5-.75 1.03-.44 1.76a11.4 11.4 0 0 0 6.42 6.42c.74.3 1.27.06 1.77-.45l.48-.5-2.28-1.73-.94.94a9.5 9.5 0 0 1-3.65-3.65l.93-.94-1.78-2.32-.51.48Z" />
          </svg>
          <span>Escríbenos</span>
          <ArrowIcon />
        </a>
      ) : <a href="/#contacto" class="tk-footer__link">Consulta cómo pedir <ArrowIcon /></a>}
      {tinkerlyConfig.instagramUrl && (
        <a class="tk-footer__link tk-footer__social" href={tinkerlyConfig.instagramUrl} rel="noopener noreferrer" target="_blank" aria-label="Instagram de Tinkerly, @tinkerly.ni">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.6" cy="6.4" r="1" fill="currentColor" stroke="none" />
          </svg>
          <span>@tinkerly.ni</span>
          <ArrowIcon />
        </a>
      )}
    </div>
  </div>
  <div class="tk-container tk-footer__bottom"><small>© {year} Tinkerly · Papelería creativa</small></div>
</footer>
