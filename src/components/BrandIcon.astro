---
interface Props {
  name: 'pencil' | 'sparkle';
}
const { name } = Astro.props;
---
<svg
  class:list={['tk-brand-icon', `tk-brand-icon--${name}`]}
  viewBox="0 0 24 24"
  width="32"
  height="32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'pencil' ? (
    <>
      <path d="m4.5 19.5 4.2-1.1L20.1 7.1a2.35 2.35 0 0 0-3.3-3.3L5.5 15.2l-1 4.3Z"/>
      <path d="m14.8 6.2 3 3"/>
      <path d="m5.5 16 2.4 2.4"/>
    </>
  ) : (
    <path d="M12 2.2c1.22 6.12 3.68 8.58 9.8 9.8-6.12 1.22-8.58 3.68-9.8 9.8-1.22-6.12-3.68-8.58-9.8-9.8 6.12-1.22 8.58-3.68 9.8-9.8Z" fill="currentColor" stroke="none"/>
  )}
</svg>
